# Bridge -> IRIS superserver (technical account; never a caller identity)
WG_USER=_SYSTEM
WG_PASS=change-me

# Gateway mode: secured (default) or demo
INTEROPMCP_MODE=secured

# Demo users created by bootstrap-gateway.script; never commit a real value
INTEROPMCP_DEMO_PASSWORD=change-me

# Client-side Basic header. It must be present in the environment that launches
# opencode; persist it in ~/.bashrc (a transient `export` is lost on restart):
#   export INTEROPMCP_BASIC="Basic $(printf 'mcp_demo:%s' "$INTEROPMCP_DEMO_PASSWORD" | base64 -w0)"
# When the auth contract changes, update opencode.json + .env.example + .env + ~/.bashrc together.
# INTEROPMCP_BASIC=Basic change-me

# Optional overrides for the Python integration tests
# INTEROPMCP_BASE_URL=http://localhost:8080/mcp/interopmcp
# INTEROPMCP_IRIS_URL=http://localhost:52773