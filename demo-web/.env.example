INTEROPMCP_BASIC=

# Senha do usuário demo (criado pelo bootstrap-gateway.script)
INTEROPMCP_DEMO_PASSWORD=change-me

# Modo do gateway: secured (default) ou demo
INTEROPMCP_MODE=secured

# Credenciais da bridge iris-mcp-server para se conectar ao IRIS (superserver 1972)
WG_USER=_SYSTEM
WG_PASS=SYS

# Chave da API NVIDIA NIM
NVIDIA_API_KEY=

# Senha para proteger a interface web do Opencode (obrigatório quando exposto via ngrok)
OPENCODE_SERVER_PASSWORD=

# Base URL for IRIS web portal (used to build Message Viewer / User Portal links)
# Absolute URL (recommended): http://localhost:52773
# Remote/ngrok: use the ngrok URL that exposes IRIS port 52773 (https://xxx.ngrok-free.app)
# App-relative prefix (routed through this app's /iris proxy): /iris
IRIS_WEB_BASE=http://localhost:52773

# Restricted CNPJ list read by the backend to build the tutorial approval step
# (same list the OpenCode agent reads; copied into the image from iris/config/)
RESTRICTED_CNPJS_FILE=/app/config/restricted_cnpjs.txt
