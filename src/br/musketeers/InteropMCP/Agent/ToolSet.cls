/// IRIS MCP Gateway - the tool surface the agent is given.
/// The agent reaches the production's capabilities through the published
/// tools, so that the classification, the human approval gate, the invocation
/// record, and the audit trail apply to the agent's actions exactly as they
/// apply to a direct caller's. The surface is the generated class that holds
/// the capabilities the adapter allows - never the agent's own entry, so the
/// agent cannot call itself.
/// The class it includes is generated by the catalogue builder on every
/// catalogue build, from the same catalogue the published tools come from.
/// The stub of that generated class is checked in so that this class compiles
/// before the first catalogue build.
/// The surface also carries the file reading tool: an agent that must consult
/// a list or a record the production names reads it and decides for itself
/// what to do with what it read.
Class br.musketeers.InteropMCP.Agent.ToolSet Extends %AI.ToolSet [ DependsOn = br.musketeers.InteropMCP.AgentTools ]
{

XData Definition [ MimeType = text/xml ]
{
<ToolSet Name="InteropMCPAgentTools">
  <Description>The production's capabilities and the human-approval request tool, as the agent may reach them.</Description>
  <Include Class="br.musketeers.InteropMCP.AgentTools"></Include>
  <Include Class="br.musketeers.InteropMCP.MetaTools"></Include>
  <Include Class="br.musketeers.InteropMCP.FileTools"></Include>
</ToolSet>
}

}
