/// IRIS MCP Gateway - meta tools not backed by a production Business Service.
/// These tools are published directly in the catalog (not generated by
/// Registry.BuildCatalog) and provide gateway-level capabilities such as
/// requesting a human-approval workflow for any tool execution.
Class br.musketeers.InteropMCP.MetaTools Extends %AI.Tool
{

/// Requests a human-approval workflow for any tool execution, independent of
/// the target Business Service classification.
///
/// The agent calls this when it decides (e.g. after reading a restricted CNPJ
/// list) that an operation needs human review before reaching the production.
/// The MCP creates an Invocation (pending-approval), an Approval request and a
/// native IRIS Workflow task. The agent receives _status: "held" and can poll
/// the outcome with GetInvocationStatus(invocationId).
///
/// After a human approves (via Workflow portal or terminal Approvals.Approve),
/// the stored invocation is replayed through Invoker.Invoke, which fires the
/// target Business Service.
///
/// pParams is a JSON string carrying the arguments for the target tool.
ClassMethod CreateWorkflowTask(pToolName As %String, pParams As %String, pReason As %String = "") As %DynamicObject
{
    Set result = ##class(%DynamicObject).%New()

    // Resolve the caller identity
    Set agent = ##class(br.musketeers.InteropMCP.Guardrails).CurrentAgent()

    // Parse the JSON params
    Set params = ##class(%DynamicObject).%FromJSON(pParams)
    If '$IsObject(params) {
        Do result.%Set("_status", "error")
        Do result.%Set("message", "Invalid JSON in pParams")
        Quit result
    }

    // Record the invocation (pending-approval)
    Set invId = ""
    Set sc = ##class(br.musketeers.InteropMCP.Invocations).CreateInvocation(pToolName, agent, params, .invId)
    If $$$ISERR(sc) {
        Do result.%Set("_status", "error")
        Do result.%Set("message", "Failed to create invocation")
        Quit result
    }

    // Create the approval request linked to this invocation
    Set apId = ""
    Set sc = ##class(br.musketeers.InteropMCP.Approvals).CreateRequest(invId, .apId)
    If $$$ISERR(sc) {
        Do result.%Set("_status", "error")
        Do result.%Set("message", "Failed to create approval")
        Quit result
    }

    // Create the linked Workflow task (non-blocking)
    Set sc = ##class(br.musketeers.InteropMCP.WorkflowBridge).CreateTask(apId)
    If $$$ISERR(sc) {
        // Log but continue: approval remains usable via terminal
        Set logData = ##class(%DynamicObject).%New()
        Do logData.%Set("tool", pToolName)
        Do logData.%Set("taskError", $System.Status.GetErrorText(sc))
        Do ##class(br.musketeers.InteropMCP.Log).Write("warn", "metatools", "WorkflowTaskNonBlocking", logData)
    }

    // Mark as pending-approval
    Do ##class(br.musketeers.InteropMCP.Invocations).UpdateStatus(invId, "pending-approval", "", "", 0)

    // Return held result to the agent
    Do result.%Set("_status", "held")
    Do result.%Set("invocationId", invId)
    Do result.%Set("approvalId", apId)
    Do result.%Set("message", "Human-approval workflow created. Use GetInvocationStatus with invocationId to check progress.")

    Quit result
}

}